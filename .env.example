# ==========================================
# 🏠 LOCAL DEVELOPMENT CONFIGURATION
# ==========================================
# Set DEV_MODE=1 to bypass Google OAuth and use the "Developer Bypass" button
DEV_MODE=1
OAUTHLIB_INSECURE_TRANSPORT=1
SECRET_KEY=dev-secret-key-change-this-in-prod
ADMIN_EMAIL=admin@example.com

# Backend & Frontend URLs for Local
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Placeholder Credentials (Not needed if DEV_MODE=1)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ==========================================
# 🚀 PRODUCTION CONFIGURATION (Example)
# ==========================================
# DEV_MODE=0
# OAUTHLIB_INSECURE_TRANSPORT=0
# SECRET_KEY=your-very-secure-random-secret-key
# ADMIN_EMAIL=your-actual-admin-email@gmail.com
# FRONTEND_URL=https://your-frontend-app.vercel.app
# ALLOWED_ORIGINS=https://your-frontend-app.vercel.app
# GOOGLE_CLIENT_ID=your-real-google-client-id
# GOOGLE_CLIENT_SECRET=your-real-google-client-secret
